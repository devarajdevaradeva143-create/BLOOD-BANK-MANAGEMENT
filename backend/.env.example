# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bloodbank?retryWrites=true&w=majority
MONGO_URI=

# Auth (use long random strings in production, e.g. `openssl rand -base64 64`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP (phone) — log only, full free. Console-la OTP varum.
OTP_PROVIDER=log
OTP_PROVIDER_KEY=dummy-key-for-sms-provider
OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# Email OTP (free) — Gmail App Password vechi
# Gmail 2-step ON -> App Password create pannu (16 letters)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Life Saver <noreply@gmail.com>

# Clerk phone verification for Donor register (server-side ONLY).
# DEPRECATED — donor flow is Supabase-only OTP now. Kept for transition.
# Publishable key goes to Donor-Frontend (.env.local); SECRET stays here.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Supabase-only OTP (donor flow, Option A).
# Frontend uses VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY (.env.local).
# SERVICE_ROLE key never goes to frontend — Render Secret only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PIN pepper (optional extra secret appended before bcrypt)
PIN_PEPPER=

# Seed users (used by `npm run seed`) — must satisfy 8+strong rule
# (8+ chars, uppercase, lowercase, number & special character).
SEED_DISTRICT_ADMIN_ID=DIST-001
SEED_DISTRICT_ADMIN_PIN=Dist@1234
SEED_DISTRICT_ADMIN_DISTRICT=
SEED_SUPER_ADMIN_ID=SUPER001
SEED_SUPER_ADMIN_PIN=Admin@123
SEED_SUPER_ADMIN_DISTRICT=

# Chatbot (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
CHAT_MAX_TOKENS=500
