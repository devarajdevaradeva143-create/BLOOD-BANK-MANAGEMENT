# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bloodbank?retryWrites=true&w=majority
MONGO_URI=

# Auth (use long random strings in production, e.g. `openssl rand -base64 64`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP
OTP_PROVIDER=log
OTP_PROVIDER_KEY=dummy-key-for-sms-provider
OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# PIN pepper (optional extra secret appended before bcrypt)
PIN_PEPPER=

# Seed users (used by `npm run seed`) — must satisfy 8+strong rule
# (8+ chars, uppercase, lowercase, number & special character).
SEED_DISTRICT_ADMIN_ID=DIST-001
SEED_DISTRICT_ADMIN_PIN=Dist@1234
SEED_DISTRICT_ADMIN_DISTRICT=
SEED_SUPER_ADMIN_ID=SUPER001
SEED_SUPER_ADMIN_PIN=Admin@123
SEED_SUPER_ADMIN_DISTRICT=
SEED_HOSPITAL_EMAIL=demo@hospital.com
SEED_HOSPITAL_PASSWORD=Demo@1234

# Chatbot (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHAT_MAX_TOKENS=500
